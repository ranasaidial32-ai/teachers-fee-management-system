# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── MySQL Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edupay_db
DB_USER=root
DB_PASS=yourpassword

# ─── JWT ──────────────────────────────────────────────────
# Access token expires in 15 minutes (per PRD Section 10)
JWT_ACCESS_SECRET=your_very_secure_access_secret_min_64_chars
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Firebase Admin SDK ───────────────────────────────────
# Path to downloaded service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# ─── Cloudflare R2 (S3-compatible) ───────────────────────
# From Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=edupay-files
R2_PUBLIC_URL=https://<account_id>.r2.cloudflarestorage.com

# Signed URL expiry in seconds (12h = 43200)
R2_SIGNED_URL_EXPIRES=43200

# File auto-delete cron interval — 12h after upload
FILE_DELETE_AFTER_HOURS=12

# Max file upload size in bytes (25 MB per PRD Section 11)
MAX_FILE_SIZE_BYTES=26214400

# ─── Cron ─────────────────────────────────────────────────
# Daily fee overdue check — runs at 00:01 UTC
FEE_CRON_SCHEDULE=1 0 * * *

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_ROUNDS=12