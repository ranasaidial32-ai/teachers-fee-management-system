# ============================================================
# .gitignore — EduPay Full-Stack Project
#
# PRD Reference: Section 10 — Security & Compliance
#   JWT secrets, Firebase service account, R2 keys, and
#   keystore credentials must NEVER be committed to git.
#
# SECRETS PROTECTED:
#   backend/.env              — All production environment variables
#   firebase-service-account.json — Firebase Admin SDK private key
#   key.properties            — Android signing keystore credentials
#   *.jks / *.keystore        — Android keystore files
#   ios/Runner/GoogleService-Info.plist — Firebase iOS config with API keys
#   android/app/google-services.json   — Firebase Android config with API keys
# ============================================================

# ── Operating System ──────────────────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo

# Windows
desktop.ini

# Linux
*~

# ── IDE & Editors ────────────────────────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml

# ── Flutter / Dart ────────────────────────────────────────────────────────────

# Flutter build outputs
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Dart generated files (Hive, Riverpod, JSON serialization)
*.g.dart
*.freezed.dart
*.mocks.dart

# Flutter web
lib/generated_plugin_registrant.dart

# Coverage
coverage/
lcov.info

# ── Android ───────────────────────────────────────────────────────────────────

# Gradle build outputs
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties

# !! SECURITY: Firebase config contains API keys
# Generated by: flutterfire configure
android/app/google-services.json

# !! SECURITY: Android signing credentials
# Create android/key.properties locally — never commit
android/key.properties
*.jks
*.keystore

# ProGuard mapping (contains class name mappings — keep private)
android/app/proguard-mapping.txt

# ── iOS ───────────────────────────────────────────────────────────────────────

# Xcode build outputs
ios/build/
ios/.symlinks/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.flx
ios/Flutter/app.zip

# CocoaPods
ios/Pods/
ios/.symlinks/
ios/Podfile.lock

# !! SECURITY: Firebase iOS config contains API keys and bundle ID
# Generated by: flutterfire configure
ios/Runner/GoogleService-Info.plist

# Xcode project user data
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# ── Backend (Node.js) ────────────────────────────────────────────────────────

# Dependencies — install with: npm install
backend/node_modules/

# !! SECURITY: Contains all production secrets
# Copy from backend/.env.example and fill in values
backend/.env
backend/.env.local
backend/.env.production
backend/.env.staging

# !! SECURITY: Firebase Admin SDK private key
# Download from Firebase Console → Project Settings → Service Accounts
backend/src/config/firebase-service-account.json
backend/src/config/*.json

# Backend logs — production logs should go to log aggregator
backend/logs/
backend/*.log
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*

# Uploaded files (streamed to R2 — no local retention)
backend/uploads/
backend/tmp/

# ── Firebase ─────────────────────────────────────────────────────────────────

# !! SECURITY: Contains project ID, API keys, sender ID
# Generated by: flutterfire configure
# Both files are auto-generated — add to git only if public project
google-services.json
GoogleService-Info.plist

# Firebase debug log
.firebase/

# ── Environment Files (Root Level) ───────────────────────────────────────────

.env
.env.*
!.env.example
!backend/.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# ── Dependencies ─────────────────────────────────────────────────────────────

node_modules/
.npm
.yarn-integrity
.pnp.*
.pnp.js

# ── Test & Coverage ───────────────────────────────────────────────────────────

.nyc_output/
coverage/
*.lcov
test-results/
junit.xml

# ── Certificates & Keys ───────────────────────────────────────────────────────
# PRD Section 10: Security & Compliance

*.pem
*.p12
*.p8
*.cer
*.der
*.pfx
*.key
!*.pub.key

# ── Misc ──────────────────────────────────────────────────────────────────────

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.cache

# Archives
*.zip
*.tar.gz
*.rar
*.7z