# Podfile
# EduPay iOS CocoaPods dependency management.
#
# PRD Reference: Section 08 — Tech Stack
#   "Mobile App: Flutter 3.x (Dart) — Single codebase for iOS + Android"
#
# KEY CONFIGURATIONS:
#   platform :ios, '12.0' — minimum iOS version (Flutter 3.x requirement)
#   use_frameworks! :linkage => :static — required for Firebase on iOS
#   Firebase pods auto-managed by firebase_messaging Flutter plugin
#
# SETUP INSTRUCTIONS:
#   1. cd ios
#   2. pod install
#   3. Open Runner.xcworkspace (NOT .xcodeproj)
#
# After adding new Flutter plugins: pod install
# After iOS update: pod update

# ── Platform Minimum ──────────────────────────────────────────────────────────
# Flutter 3.x requires iOS 12.0 minimum
platform :ios, '12.0'

# ── CocoaPods Config ──────────────────────────────────────────────────────────
# Disable analytics reporting to CocoaPods
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# ── Project Definition ────────────────────────────────────────────────────────
project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# ── Flutter Helpers ───────────────────────────────────────────────────────────
def flutter_root
  generated_xcode_build_settings_path =
    File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. " \
          "If you're running pod install manually, make sure " \
          "flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. " \
        "Try deleting Generated.xcconfig and regenerating."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root,
)

# ── Pre-Install ───────────────────────────────────────────────────────────────
flutter_ios_podfile_setup

# ── Target: Runner ────────────────────────────────────────────────────────────
target 'Runner' do
  # Static frameworks required by Firebase on iOS
  # Must be set BEFORE flutter_install_all_ios_pods
  use_frameworks! :linkage => :static

  # Disable Flipper (React Native debug tool — not needed in Flutter)
  # Prevents compilation conflicts
  # use_flipper!

  # Install all Flutter plugin pods
  # This reads all Flutter plugin dependencies from pubspec.yaml
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── Test Target ─────────────────────────────────────────────────────────────
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# ── Post-Install ──────────────────────────────────────────────────────────────
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Minimum iOS deployment target — must match platform :ios above
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'

      # Disable bitcode — Firebase requires bitcode = NO
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Fix BoringSSL-GRPC compilation on Apple Silicon
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'

      # Suppress deprecation warnings in pods (not our code)
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'

      # Required for WorkManager (flutter_workmanager) background tasks
      config.build_settings['SWIFT_VERSION'] = '5.0'

      # Enable module stability for Swift interop
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
    end
  end
end